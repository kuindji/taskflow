{
    "name": "taskflow",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "electron"
    ],
    "scripts": {
        "dev:backend": "cd packages/backend && bun run dev",
        "dev:ui": "cd packages/ui && bun run dev",
        "dev:electron": "cd electron && bun run dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "bun run --filter '*' typecheck",
        "test": "bun test",
        "build": "bun run build:backend && bun run build:ui && bun run build:electron",
        "build:backend": "cd packages/backend && bun run build",
        "build:backend:bin": "cd packages/backend && bun run build:bin",
        "build:ui": "cd packages/ui && bun run build",
        "build:electron": "cd electron && bun run build",
        "package": "bun run build:backend:bin && bun run build:ui && bun run build:electron && cd electron && bun run pack",
        "dist": "bun run build:backend:bin && bun run build:ui && bun run build:electron && cd electron && bun run dist"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.10",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript-eslint": "^8.57.0"
    }
}

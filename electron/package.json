{
    "name": "taskflow",
    "version": "0.8.24",
    "description": "Desktop app for orchestrating AI coding agents",
    "author": "Ivan Kuindzhi",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "dev": "cd .. && bun run build && cd electron && electron .",
        "build": "bun run build.ts",
        "typecheck": "bunx tsc --noEmit",
        "pack": "SKIP_NOTARIZE=true electron-builder --dir",
        "dist": "electron-builder",
        "publish": "electron-builder --publish always"
    },
    "build": {
        "appId": "com.taskflow.app",
        "productName": "Taskflow",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*"
        ],
        "asarUnpack": [
            "dist/menubar-icon*.png"
        ],
        "extraResources": [
            {
                "from": "../packages/backend/dist/taskflow-backend",
                "to": "backend/taskflow-backend"
            },
            {
                "from": "../packages/ui/dist",
                "to": "ui"
            }
        ],
        "publish": {
            "provider": "github",
            "owner": "kuindji",
            "repo": "taskflow"
        },
        "afterSign": "scripts/notarize.js",
        "mac": {
            "category": "public.app-category.developer-tools",
            "identity": "Ivan Kuindzhi (9SX8S58CA8)",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "entitlements.mac.plist",
            "entitlementsInherit": "entitlements.mac.plist",
            "target": [
                "dmg",
                "zip"
            ]
        }
    },
    "devDependencies": {
        "@electron/notarize": "^3.1.1",
        "electron": "^33.0.0",
        "electron-builder": "^26.8.1"
    },
    "dependencies": {
        "electron-updater": "^6.8.3"
    }
}

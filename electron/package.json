{
    "name": "taskflow",
    "version": "0.15.1",
    "description": "Desktop app for orchestrating AI coding agents",
    "author": "Ivan Kuindzhi",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "dev": "cd .. && bun run build && cd electron && electron .",
        "build": "bun run build.ts",
        "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.src.json",
        "pack": "SKIP_NOTARIZE=true electron-builder --dir",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win --x64",
        "dist:win-arm64": "electron-builder --win --arm64",
        "dist:win:portable": "electron-builder --win portable --x64",
        "dist:win-arm64:portable": "electron-builder --win portable --arm64",
        "dist:linux": "electron-builder --linux --x64",
        "publish": "electron-builder --publish always",
        "publish:mac-all": "electron-builder --mac --x64 --arm64 --publish always",
        "publish:linux": "electron-builder --linux --x64 --publish always"
    },
    "build": {
        "appId": "com.taskflow.app",
        "productName": "Taskflow",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*"
        ],
        "asarUnpack": [
            "dist/menubar-icon*.png"
        ],
        "extraResources": [
            {
                "from": "../packages/ui/dist",
                "to": "ui"
            }
        ],
        "publish": {
            "provider": "github",
            "owner": "kuindji",
            "repo": "taskflow"
        },
        "afterSign": "scripts/notarize.js",
        "toolsets": {
            "appimage": "1.0.2"
        },
        "mac": {
            "category": "public.app-category.developer-tools",
            "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
            "identity": "Ivan Kuindzhi (9SX8S58CA8)",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "entitlements.mac.plist",
            "entitlementsInherit": "entitlements.mac.plist",
            "extendInfo": {
                "NSLocalNetworkUsageDescription": "Taskflow finds other Taskflow backends on your local network so you can connect to them."
            },
            "target": [
                "dmg",
                "zip"
            ],
            "extraResources": [
                {
                    "from": "../packages/backend/dist/${arch}/taskflow-backend",
                    "to": "backend/taskflow-backend"
                }
            ]
        },
        "portable": {
            "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
        },
        "nsis": {
            "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "extraResources": [
                {
                    "from": "../packages/backend/dist/taskflow-backend.exe",
                    "to": "backend/taskflow-backend.exe"
                },
                {
                    "from": "../packages/backend/src/services/pty-bridge.mjs",
                    "to": "backend/pty-bridge.mjs"
                },
                {
                    "from": "../packages/backend/node_modules/node-pty",
                    "to": "backend/node_modules/node-pty"
                },
                {
                    "from": "../packages/backend/node_modules/@vscode/ripgrep/bin/rg.exe",
                    "to": "backend/rg.exe"
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Development",
            "executableName": "taskflow",
            "icon": "build/icon.png",
            "artifactName": "${productName}-${version}-${arch}.${ext}",
            "extraResources": [
                {
                    "from": "../packages/backend/dist/linux/${arch}/taskflow-backend",
                    "to": "backend/taskflow-backend"
                },
                {
                    "from": "../packages/backend/dist/linux/${arch}/rg",
                    "to": "backend/rg"
                }
            ]
        }
    },
    "devDependencies": {
        "@electron/notarize": "^3.1.1",
        "electron": "^33.0.0",
        "electron-builder": "^26.8.1",
        "sharp": "^0.34.5"
    },
    "dependencies": {
        "@taskflow/shared": "workspace:*",
        "electron-updater": "^6.8.3"
    }
}

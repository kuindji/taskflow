{
    "name": "taskflow",
    "version": "0.5.3",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "dev": "cd .. && bun run build && cd electron && electron .",
        "build": "bun build src/main.ts --outdir dist --target node --format cjs --external electron --external electron-updater && bun build src/preload.ts --outdir dist --target node --format cjs --external electron",
        "typecheck": "bunx tsc --noEmit",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "publish": "electron-builder --publish always"
    },
    "build": {
        "appId": "com.taskflow.app",
        "productName": "Taskflow",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*"
        ],
        "extraResources": [
            {
                "from": "../packages/backend/dist/taskflow-backend",
                "to": "backend/taskflow-backend"
            },
            {
                "from": "../packages/ui/dist",
                "to": "ui"
            }
        ],
        "publish": {
            "provider": "github",
            "owner": "kuindji",
            "repo": "taskflow"
        },
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                "dmg",
                "zip"
            ]
        }
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^26.8.1"
    },
    "dependencies": {
        "electron-updater": "^6.8.3"
    }
}
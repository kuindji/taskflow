{
    "name": "@taskflow/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "TASKFLOW_DEV=1 bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "build:bin": "bun build src/index.ts --compile --outfile dist/taskflow-backend",
        "build:bin:win": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/taskflow-backend.exe",
        "build:cli": "bun build src/services/taskflow-cli-bin.ts --compile --outfile dist/taskflow-cli",
        "build:cli:win": "bun build src/services/taskflow-cli-bin.ts --compile --target=bun-windows-x64 --outfile dist/taskflow-cli.exe",
        "test": "bun test",
        "typecheck": "bunx tsc --noEmit"
    },
    "dependencies": {
        "@taskflow/shared": "workspace:*",
        "@xterm/addon-serialize": "^0.13.0",
        "@xterm/headless": "^5.5.0",
        "chokidar": "^3.6.0",
        "smol-toml": "^1.6.0",
        "typescript": "^5.7.0",
        "yaml": "^2.8.2"
    }
}
